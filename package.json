{
  "name": "portpreview",
  "version": "0.3.2",
  "description": "Instant secure previews for localhost apps — expose a local port through a public HTTPS URL.",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./protocol": "./lib/protocol.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "portpreview": "./bin/portpreview.mjs"
  },
  "files": [
    "bin/portpreview.mjs",
    "lib/cli-main.mjs",
    "lib/client-info.mjs",
    "lib/config-cli.mjs",
    "lib/config.mjs",
    "lib/geo.mjs",
    "lib/http-stream.mjs",
    "lib/index.mjs",
    "lib/inspector-server.mjs",
    "lib/inspector-store.mjs",
    "lib/inspector-ui.mjs",
    "lib/protocol.mjs",
    "lib/tcp-client.mjs",
    "lib/tunnel-client.mjs",
    "lib/user-config.mjs",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "npm test",
    "start": "node bin/portpreview.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "tunnel",
    "localhost",
    "preview",
    "webhook",
    "devtools",
    "cli",
    "ngrok",
    "localtunnel",
    "tcp-tunnel"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elemops/portpreview.git"
  },
  "homepage": "https://portpreview.com",
  "bugs": {
    "url": "https://github.com/elemops/portpreview/issues"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
