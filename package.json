{
  "name": "portpreview",
  "version": "0.1.1",
  "description": "Expose a local port through a public HTTPS URL — webhook debugging, OAuth callbacks, and dev previews.",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./protocol": "./lib/protocol.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "portpreview": "bin/portpreview.mjs"
  },
  "files": [
    "bin/portpreview.mjs",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepublishOnly": "npm test",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "tunnel",
    "localhost",
    "preview",
    "webhook",
    "devtools",
    "cli",
    "ngrok",
    "localtunnel"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elemops/portpreview.git"
  },
  "homepage": "https://portpreview.com",
  "bugs": {
    "url": "https://github.com/elemops/portpreview/issues"
  },
  "dependencies": {
    "ws": "^8.19.0"
  }
}
